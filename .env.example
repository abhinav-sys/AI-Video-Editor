# Keep defaults; copy to backend/.env and frontend/.env.local locally.
# Never commit real secrets.

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./app.db
STORAGE_ROOT=./storage
MAX_CONCURRENT_RENDERS=2
MAX_UPLOAD_SIZE_MB=500
CORS_ORIGINS=http://localhost:3000

API_KEY=dev-api-key-change-me
AUTH_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
LLM_PROVIDER=mock

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Creatomate (direct API engine — keep secret, never expose to the frontend)
CREATOMATE_API_KEY=
CREATOMATE_DEFAULT_TEMPLATE_ID=
CREATOMATE_API_BASE=https://api.creatomate.com/v1
CREATOMATE_POLL_INTERVAL_SEC=2
CREATOMATE_POLL_TIMEOUT_SEC=300
# Public origin Creatomate can reach (ngrok/cloudflare tunnel to this API). Preferred over temp hosts.
# PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Frontend (.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_KEY=dev-api-key-change-me
