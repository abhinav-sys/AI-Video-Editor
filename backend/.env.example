# Local SQLite + inline worker (default for Windows/dev without Docker queue)
DATABASE_URL=sqlite:///./app.db
USE_INLINE_WORKER=true
STORAGE_ROOT=./storage
CORS_ORIGINS=http://localhost:3000
API_KEY=dev-api-key-change-me
AUTH_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
MAX_CONCURRENT_RENDERS=2

# Docker / durable queue (see docker-compose.yml)
# DATABASE_URL=postgresql+psycopg://vgai:vgai@localhost:5432/vgai
# USE_INLINE_WORKER=false
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OCR / CV feature flags
OCR_PROVIDER=easyocr
# Isolate EasyOCR in a child process (avoids Windows access-violation killing the API)
OCR_SUBPROCESS=true
OCR_SUBPROCESS_TIMEOUT_SEC=180
ENABLE_LAMA_INPAINT=false
ENABLE_VISION_DETECT=true
MAX_SHOTS_SAMPLED=12
# FONTS_DIR=./assets/fonts
# HWACCEL=
